POSTGRES_NAME=crm-fastapi-db
POSTGRES_HOST=crm-postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASS=your_password

POSTGRES_URL=${POSTGRES_USER}:${POSTGRES_PASS}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_NAME}

SECRET_KEY=your_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
